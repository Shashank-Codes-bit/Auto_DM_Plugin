# ---- Instagram (from the Meta app: Instagram → API setup with Instagram login) ----
IG_ACCESS_TOKEN=your-long-lived-instagram-token
# Your Instagram professional account ID (shown in Admin → Brand & settings once the token works)
IG_USER_ID=
# Instagram app secret (used to verify webhook signatures). If webhooks get rejected with
# "bad signature", use App settings → Basic → App secret instead.
APP_SECRET=
# Any string you choose; enter the same value in Meta's webhook settings
VERIFY_TOKEN=pick-a-random-string
GRAPH_VERSION=v23.0
# 1 = only log DMs instead of sending them
DRY_RUN=0
# 1 = each person gets at most one DM per reel
ONE_DM_PER_USER=0

# ---- Website ----
PORT=3000
# The public address of this server (reel pages and admin).
PUBLIC_BASE_URL=
# Optional: put another site's address in DMs instead (that site must redirect /l/<slug> to this one).
DM_LINK_BASE=

# ---- Brand owner ----
# The owner logs in on /login with this mobile number + password.
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=choose-a-strong-password
# Long random string; keeps the owner logged in across restarts
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Product links ----
# Re-check prices on the brand's website when older than this many hours (0 = never)
LINK_REFRESH_HOURS=24

# ---- Database ----
# Leave empty to use the built-in database stored in data/pgdata.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
