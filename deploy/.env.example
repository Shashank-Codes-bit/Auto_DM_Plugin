# Copy to deploy/.env on the server (never commit it): cp .env.example .env && nano .env
# CLIENT and PORT pick the Docker project name and the localhost port (one per client).
CLIENT=plantstore
PORT=8110

# ---- Website ----
# Public address of this install (the reel pages and the admin panel)
PUBLIC_BASE_URL=
# Optional: another site whose /l/<slug> redirects here, used for the link inside DMs.
# Leave empty to use PUBLIC_BASE_URL.
DM_LINK_BASE=

# ---- Brand owner: logs in on /login ----
ADMIN_PHONE=
ADMIN_PASSWORD=
# Long random string, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# ---- Instagram (Meta app → Instagram → API setup with Instagram login) ----
IG_ACCESS_TOKEN=
IG_USER_ID=
APP_SECRET=
VERIFY_TOKEN=
GRAPH_VERSION=v23.0
DRY_RUN=0
ONE_DM_PER_USER=0

# ---- Product links ----
# Re-check prices on the brand's website when older than this many hours (0 = never)
LINK_REFRESH_HOURS=24

# ---- Database ----
# Empty = built-in database in the /data volume (DATA_DIR is set in compose.yaml).
DATABASE_URL=
